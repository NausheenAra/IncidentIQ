# IncidentIQ configuration template.
# Copy to .env and edit:  cp .env.example .env
# NEVER commit .env. Do not put real secrets in this example file.

APP_NAME=IncidentIQ
# development | test | production  (production enforces a strong API_KEY)
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

API_HOST=0.0.0.0
API_PORT=8000
# Protects the approve and injection endpoints. If left blank in development a
# random key is generated on every start, which scripts and the dashboard cannot
# know - so set a stable one. Generate it with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Production (APP_ENV=production) requires at least 32 characters.
API_KEY=

# SQLite file. Note: inside Kubernetes on an emptyDir volume this is NOT durable.
DATABASE_PATH=./data/incidentiq.db

# Get a key from https://aistudio.google.com/ . Leave blank to use the
# deterministic fallback analysis instead of Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Seconds to wait for a Gemini response before falling back.
GEMINI_TIMEOUT_SECONDS=30

# Comma-separated, explicit namespaces IncidentIQ may inspect and remediate.
# Wildcards are rejected.
KUBERNETES_NAMESPACE_ALLOWLIST=default
DETECTOR_INTERVAL_SECONDS=10
UNHEALTHY_POD_GRACE_SECONDS=30

# false = diagnose, then wait for an authenticated approval (recommended).
AUTO_REMEDIATE=false
# python = Kubernetes client patches the previous ReplicaSet template
# kubectl = runs "kubectl rollout undo" (needs kubectl in the backend image)
ROLLBACK_MODE=python
# Hard maximum is 2 attempts per incident.
MAX_REMEDIATION_ATTEMPTS=2
# Replica target used by the "scale" action (1-10).
SCALE_TARGET_REPLICAS=2
VERIFICATION_TIMEOUT_SECONDS=120
VERIFICATION_INTERVAL_SECONDS=5

# No new incident for the same service for this long after one closes.
INCIDENT_COOLDOWN_SECONDS=60

# A recorded failure injection (POST /api/injection) is only used to compute
# MTTD if the detector notices the failure within this many seconds. Older,
# unclaimed injections are treated as stale and ignored.
INJECTION_MAX_AGE_SECONDS=600
